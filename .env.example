# Public https URL of the gateway, e.g. https://mcp.<tailnet>.ts.net
PUBLIC_URL=

# Shared secret between gateway and bibliofil-mcp. Make one with:
#   openssl rand -hex 32
BIBLIOFIL_TOKEN=

# Optional: admin password, at least 40 characters (openssl rand -base64 36).
# Leave empty to get a generated one, printed in the gateway log.
ADMIN_PASSWORD=

# Tailscale Funnel
TS_AUTHKEY=
TS_HOSTNAME=mcp

# Cloudflare Tunnel (if you use the cloudflared service instead)
CLOUDFLARE_TUNNEL_TOKEN=

# Optional library settings (otherwise set them on the admin page)
BIBLIOFIL_URL=
BIBLIOFIL_USER=
BIBLIOFIL_PIN=
BIBLIOFIL_PICKUP=
BIBSOK_PICKUP=

# Logging: debug includes redacted MCP request/response bodies.
LOG_LEVEL=info

# Optional OTLP/HTTP tracing; disabled unless an endpoint is set.
# Use compose.telemetry.yaml for a local Jaeger test receiver.
OTEL_SERVICE_NAME=mcp-gateway
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1

# Jaeger test receiver: use the VM private IP for direct network access.
JAEGER_BIND_ADDRESS=127.0.0.1

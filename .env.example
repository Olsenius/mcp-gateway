# Public https URL of the gateway, e.g. https://mcp.<tailnet>.ts.net
PUBLIC_URL=

# Shared secrets between the gateway and each MCP server, one per server.
# Make each with: openssl rand -hex 32
BIBLIOFIL_TOKEN=
VIGILO_TOKEN=
FRIBO_TOKEN=
TIBI_TOKEN=
SPOND_TOKEN=
MEMORY_TOKEN=

# Optional: admin password, at least 40 characters (openssl rand -base64 36).
# Leave empty to get a generated one, retrievable with /mcp-gateway -print-admin-password.
ADMIN_PASSWORD=

# Optional: "Log in with ..." through an OpenID Connect provider, in addition
# to the admin password. Callback URL to register: ${PUBLIC_URL}/admin/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# At least one of these: groups (recommended) or verified e-mail addresses.
OIDC_ALLOWED_GROUPS=
OIDC_ALLOWED_USERS=
OIDC_LABEL=

# Tailscale Funnel
TS_AUTHKEY=
TS_HOSTNAME=mcp

# Cloudflare Tunnel (if you use the cloudflared service instead)
CLOUDFLARE_TUNNEL_TOKEN=

# Optional library settings (otherwise set them on the admin page)
BIBLIOFIL_URL=
BIBLIOFIL_USER=
BIBLIOFIL_PIN=
BIBLIOFIL_PICKUP=
BIBSOK_PICKUP=

# Optional Fribo settings (otherwise set them on the admin page)
FRIBO_EMAIL=
FRIBO_PASSWORD=
FRIBO_CABIN_ID=
# true hides the tools that register, change and cancel stays
FRIBO_READ_ONLY=false

# Optional Tibi settings (otherwise set them on the admin page)
TIBI_CARD_NUMBER=
TIBI_PIN=
# Tibi is read-only until turned off here or on the admin page. true hides the
# tools that borrow, send to Kindle and change the Kindle address.
TIBI_READ_ONLY=

# Optional Spond settings (otherwise set them on the admin page)
SPOND_USERNAME=
SPOND_PASSWORD=
# Limit the kids to these first names, e.g. Astrid,Arvid. Empty finds every
# kid the account is a guardian for.
SPOND_KIDS_CONFIG=
# true hides and refuses the tool that answers events
SPOND_READ_ONLY=

# Logging: debug includes redacted MCP request/response bodies.
LOG_LEVEL=info

# Optional OTLP/HTTP tracing; disabled unless an endpoint is set.
# Use compose.telemetry.yaml for a local Jaeger test receiver.
OTEL_SERVICE_NAME=mcp-gateway
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1

# Jaeger test receiver: use the VM private IP for direct network access.
JAEGER_BIND_ADDRESS=127.0.0.1

# Only trust the exact reverse proxy addresses, e.g. 127.0.0.1/32,::1/128.
TRUSTED_PROXIES=

# memory-mcp: shared agent memory over the private vault.
# The deploy key and the pinned GitHub host keys are mounted as Docker secrets;
# give their paths on the host here. Keep MEMORY_READ_ONLY=true until the
# vault's enabling change (memory-mcp docs/spec.md, Appendix B) is applied.
MEMORY_READ_ONLY=true
MEMORY_GIT_REMOTE=git@github.com:Olsenius/agent.git
MEMORY_GIT_BRANCH=main
MEMORY_DEPLOY_KEY_PATH=./secrets/memory_deploy_key
MEMORY_KNOWN_HOSTS_PATH=./secrets/memory_known_hosts
# Optional, read-only GitHub App used only to read the checks for a commit.
MEMORY_GITHUB_APP_ID=
MEMORY_GITHUB_INSTALLATION_ID=
MEMORY_GITHUB_APP_KEY_FILE=
